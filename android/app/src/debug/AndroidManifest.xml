<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- L3: allow cleartext HTTP/WS in DEBUG builds only, so a local Fastify
         backend (http://10.0.2.2:3001 or a LAN IP) works during development.
         Release builds (main manifest) have this flag unset, so they refuse
         cleartext and require HTTPS. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
